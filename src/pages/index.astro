---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const destination = `${base}en/`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta http-equiv="refresh" content={`0;url=${destination}`} />
		<link rel="canonical" href={new URL(destination, Astro.site)} />
		<title>Crypto Founder Wiki</title>
	</head>
	<body>
		<p><a href={destination}>Enter Crypto Founder Wiki</a></p>
	</body>
</html>
